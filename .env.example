# ---------------------------------------------------------------- ANALYSE
# Sans cette clé l'application marche quand même, en analyse déterministe :
# elle lit les crochets du prompteur et les capitales, mais elle ne comprend
# rien — libellés approximatifs. La clé fait passer au jugement par modèle.
ANTHROPIC_API_KEY=

# ----------------------------------------------------------------- IMAGES
# Le fournisseur d'images est interchangeable. La vignette sert d'entrée
# image-to-video : elle décide à quoi ressemble le clip, elle n'est pas un
# aperçu jetable. Choisissez le meilleur modèle dont vous disposez.
#   seedream | gemini | openai | higgsfield
IMAGE_PROVIDER=seedream

GEMINI_API_KEY=
GEMINI_MODEL_IMAGE=gemini-2.5-flash-image

OPENAI_API_KEY=
OPENAI_MODEL_IMAGE=gpt-image-1

# Higgsfield : en-tête « Authorization: Key <id>:<secret> », pas un Bearer.
# Génération asynchrone : l'attente est gérée par le code.
HIGGSFIELD_KEY_ID=
HIGGSFIELD_KEY_SECRET=
HIGGSFIELD_BASE_URL=https://api.higgsfield.ai
HIGGSFIELD_PATH_IMAGE=/higgsfield-ai/soul/v2/standard

# ------------------------------------------------- VIDÉO + Seedream (ModelArk)
# Une seule clé couvre Seedance (vidéo) et Seedream (images).
ARK_API_KEY=
ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
ARK_MODEL_VIDEO=dreamina-seedance-2-5-260628
ARK_MODEL_IMAGE=dola-seedream-5-0-pro-260628

# --------------------------------------------------------------- PERSISTANCE
# Nécessaire dès qu'un fournisseur renvoie du base64 (Gemini, OpenAI) : le
# moteur vidéo lit l'image de référence par URL publique, il faut la déposer.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Protège la route cron qui fait avancer la file de génération.
CRON_SECRET=
